@startuml diagrama_caso_uso
title SGB - Diagrama de Casos de Uso
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor Administrador as Admin

rectangle "Sistema de Gestión Bibliotecaria (SGB)" {

  usecase "Gestionar usuarios" as UC1
  usecase "Registrar / actualizar usuario" as UC1a
  usecase "Desactivar usuario" as UC1b

  usecase "Gestionar libros" as UC2
  usecase "Registrar / actualizar libro" as UC2a
  usecase "Buscar libro" as UC2b
  usecase "Agregar ejemplares" as UC2c

  usecase "Gestionar préstamos" as UC3
  usecase "Crear préstamo" as UC3a
  usecase "Registrar devolución" as UC3b
  usecase "Validar límites y multas" as UC3c
  usecase "Generar multa por retraso" as UC3d

  usecase "Gestionar reservas" as UC4
  usecase "Crear reserva" as UC4a
  usecase "Cancelar reserva" as UC4b
  usecase "Activar (atender) reserva" as UC4c

  usecase "Gestionar multas" as UC5
  usecase "Generar multas por vencidos" as UC5a
  usecase "Cobrar multa" as UC5b
  usecase "Reporte de morosidad" as UC5c

  usecase "Ver análisis" as UC6
  usecase "Libros más prestados" as UC6a
  usecase "Préstamos por categoría" as UC6b
  usecase "Tasa de infracción" as UC6c
  usecase "Duración promedio y reporte de multas" as UC6d
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6

UC1 ..> UC1a : <<include>>
UC1 ..> UC1b : <<include>>

UC2 ..> UC2a : <<include>>
UC2 ..> UC2b : <<include>>
UC2 ..> UC2c : <<include>>

UC3 ..> UC3a : <<include>>
UC3 ..> UC3b : <<include>>
UC3a ..> UC3c : <<include>>
UC3d ..> UC3b : <<extend>>\n[devolución con retraso]

UC4 ..> UC4a : <<include>>
UC4 ..> UC4b : <<include>>
UC4 ..> UC4c : <<include>>

UC5 ..> UC5a : <<include>>
UC5 ..> UC5b : <<include>>
UC5 ..> UC5c : <<include>>

UC6 ..> UC6a : <<include>>
UC6 ..> UC6b : <<include>>
UC6 ..> UC6c : <<include>>
UC6 ..> UC6d : <<include>>
@enduml
